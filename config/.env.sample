# Copy to ../.env  (repo root) and fill in. The .env file is gitignored.
#
# Fine-grained personal access token.
#
#   Repository access : only the repos you list in config/repos/
#   Permissions       : Contents        -> Read-only
#                       Pull requests   -> Read and write
#                       Checks          -> Read-only
#                       Commit statuses -> Read-only
#                       Metadata        -> Read-only  (mandatory, auto-selected)
#
# Checks and Commit statuses are what let the reviewer see whether CI is green.
# Without them GitHub refuses the statusCheckRollup GraphQL field, and the
# reviewer skips every PR rather than guess (a token that cannot see CI would
# otherwise approve pull requests with failing builds).
#
# Contents: Read-only is what makes it impossible for this tool to push a
# commit, create a branch, or merge. Pull requests: Read and write is the
# minimum that allows posting reviews, replying to threads, and resolving
# conversations.
#
# Create at: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Only set this if you point the tool at GitHub Enterprise Server.
# GITHUB_API_URL=https://github.example.com/api/v3
# GITHUB_GRAPHQL_URL=https://github.example.com/api/graphql
