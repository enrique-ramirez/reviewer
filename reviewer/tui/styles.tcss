/* One screenful, never a scrollbar. The tabs take whatever is left after the
   fixed furniture below them, so the table shrinks to fit the terminal rather
   than the window growing to fit the table. Every link in that chain has to be
   constrained: one `height: auto` between Screen and a table and the whole
   thing overflows again. */

Screen {
    background: $surface;
    overflow: hidden;
}

#shell { height: 1fr; }
#body { width: 1fr; }

/* Wide enough for a repository name, its owner and its counts, and full
   height, because a panel that stops halfway down reads as a stray box. */
/* Widths count the border and both padding columns, so the usable text width
   is three less than this. The stats line is the longest thing in here. */
RepoSidebar {
    width: 38;
    height: 1fr;
    padding: 0 1;
    background: $panel;
    border-right: solid $panel-lighten-2;
}
/* Focus is shown the way the tables show it, so the sidebar reads as one more
   panel you can click into rather than a decoration. */
RepoSidebar:focus { border-right: solid $accent; }

/* Collapsed is a rail, not a disappearance: one glyph per repository, so the
   fact that there are others survives folding the panel away. */
RepoSidebar.collapsed { width: 6; }
/* Collapsed, the header is just the arrow — centred, so it lines up with the
   rail of ghosts under it rather than hanging off the top. */
RepoSidebar.collapsed SidebarHeader {
    height: 3;
    margin-bottom: 0;
    content-align: center middle;
    padding: 0;
}
RepoSidebar.collapsed RepoRow {
    height: 1;
    margin-bottom: 0;
}

SidebarHeader {
    height: 1;
    margin-bottom: 1;
    color: $text-muted;
    content-align: left middle;
}
SidebarHeader:hover { background: $boost; }

/* A blank line between rows: three lines of text with no gap reads as one
   paragraph rather than three things you can point at. */
RepoRow {
    height: 3;
    margin-bottom: 1;
}
RepoRow:hover { background: $boost; }
RepoSidebar:focus RepoRow.chosen { background: $primary-darken-3; }

#repobar_hint { height: auto; }

TabbedContent { height: 1fr; }
TabbedContent ContentSwitcher { height: 1fr; }
TabPane {
    height: 1fr;
    padding: 0;
}

RecordView { height: 1fr; }
RecordView > Horizontal { height: 1fr; }

/* The two columns of a tab. The divider belongs to the column rather than to
   the table, so it runs past the status line underneath — which is what says
   that line is about the list and not about the whole screen. */
.listing {
    width: 3fr;
    height: 1fr;
    border-right: solid $panel-lighten-2;
}
.details {
    width: 2fr;
    height: 1fr;
}

/* The status line and the filters, on one row: counts at the left edge of the
   list, controls at the right edge of it. */
.underbar {
    height: 1;
    background: $panel;
}
/* Three equal slots. Equal is what makes the middle one's centre the bar's
   centre — with an auto-width slot on either side it would drift with whatever
   they happened to contain. */
.underbar StatusBar.counts { width: 1fr; }
.underbar StatusBar.pager  { width: 1fr; content-align: center middle; }
.underbar #history_filters { width: 1fr; align-horizontal: right; }

SyncedTable {
    width: 1fr;
    height: 1fr;
}
SyncedTable > .datatable--cursor {
    background: $accent;
    color: $text;
}

DetailPane {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

StatusBar {
    height: auto;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

#author_filter {
    height: 3;
    display: none;
}
#author_filter.active { display: block; }

/* PacTimer styles itself, in widgets.py, because it lives in the header now
   and has to match whatever height the header is. A rule here would win over
   that and pin it back to one row. */

#log {
    height: 10;
    border-top: solid $panel-lighten-2;
    background: $surface-darken-1;
}
/* Hidden rather than shrunk, so the space goes back to the table. */
#log.hidden { display: none; }

/* The History filter bar: a date picker that shows the current range, sitting
   where the dim key hints used to be. One row, so it costs the table almost
   nothing — page size follows the height that is left. */
#history_filters {
    height: 1;
    padding: 0;
    /* Equal thirds put the page count on the bar's centre, but a third of a
       narrow column cannot hold a date control. The floor keeps the control
       whole and lets the centring drift instead — a page count a few columns
       off centre is a smaller loss than a clipped filter. */
    min-width: 20;
}
/* Label and control together have to fit one third of the list column, since
   equal outer thirds are what put the page count on the bar's centre. Sized
   for the longest range plus its arrow. */
#date_label {
    color: $text-muted;
    padding: 0 1 0 0;
}
#date_filter {
    width: 14;
}

/* The buttons under a detail pane: what to do with this record on the left,
   the way out to GitHub on the right. Compact, because a three-row button
   under a pane reads as a dialog rather than as an affordance. */
.actions {
    height: 1;
    padding: 0 1;
    align-horizontal: left;
}
.actions Button {
    min-width: 0;
    border: none;
    height: 1;
    background: $panel-lighten-1;
    color: $text-muted;
}
.actions Button:hover {
    background: $accent;
    color: $text;
}
.actions #action-open {
    dock: right;
}
