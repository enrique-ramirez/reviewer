/* One screenful, never a scrollbar. The tabs take whatever is left after the
   fixed furniture below them, so the table shrinks to fit the terminal rather
   than the window growing to fit the table. Every link in that chain has to be
   constrained: one `height: auto` between Screen and a table and the whole
   thing overflows again. */

Screen {
    background: $surface;
    overflow: hidden;
}

#shell { height: 1fr; }
#body { width: 1fr; }

RepoSidebar {
    width: 38;
    height: 1fr;
    padding: 0 1;
    background: $panel;
    border-right: solid $panel-lighten-2;
}
RepoSidebar:focus { border-right: solid $accent; }

RepoSidebar.collapsed { width: 6; }
RepoSidebar.collapsed SidebarHeader {
    height: 3;
    margin-bottom: 0;
    content-align: center middle;
    padding: 0;
}
RepoSidebar.collapsed RepoRow {
    height: 1;
    margin-bottom: 0;
}

SidebarHeader {
    height: 1;
    margin-bottom: 1;
    color: $text-muted;
    content-align: left middle;
}
SidebarHeader:hover { background: $boost; }

RepoRow {
    height: 3;
    margin-bottom: 1;
}
RepoRow:hover { background: $boost; }
RepoSidebar:focus RepoRow.chosen { background: $primary-darken-3; }

#repobar_hint { height: auto; }

TabbedContent { height: 1fr; }
TabbedContent ContentSwitcher { height: 1fr; }
TabPane {
    height: 1fr;
    padding: 0;
}

RecordView { height: 1fr; }
RecordView > Horizontal { height: 1fr; }

.listing {
    width: 3fr;
    height: 1fr;
    border-right: solid $panel-lighten-2;
}
.details {
    width: 2fr;
    height: 1fr;
}

.underbar {
    height: 1;
    background: $panel;
}
.underbar StatusBar.counts { width: 1fr; }
.underbar StatusBar.pager  { width: 1fr; content-align: center middle; }
.underbar #history_filters { width: 1fr; align-horizontal: right; }

SyncedTable {
    width: 1fr;
    height: 1fr;
}
SyncedTable > .datatable--cursor {
    background: $accent;
    color: $text;
}

DetailPane {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

StatusBar {
    height: auto;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

#author_filter {
    height: 3;
    display: none;
}
#author_filter.active { display: block; }

/* PacTimer styles itself, in widgets.py, because it lives in the header now
   and has to match whatever height the header is. A rule here would win over
   that and pin it back to one row. */

#log {
    height: 10;
    border-top: solid $panel-lighten-2;
    background: $surface-darken-1;
}
#log.hidden { display: none; }

#history_filters {
    height: 1;
    padding: 0;
    /* Equal thirds put the page count on the bar's centre, but a third of a
       narrow column cannot hold a date control. The floor keeps the control
       whole and lets the centring drift instead. A page count a few columns
       off centre is a smaller loss than a clipped filter. */
    min-width: 20;
}
/* Label and control together have to fit one third of the list column, since
   equal outer thirds are what put the page count on the bar's centre. Sized
   for the longest range plus its arrow. */
#date_label {
    color: $text-muted;
    padding: 0 1 0 0;
}
#date_filter {
    width: 14;
}

.actions {
    height: 1;
    padding: 0 1;
    align-horizontal: left;
}
.actions Button {
    min-width: 0;
    border: none;
    height: 1;
    background: $panel-lighten-1;
    color: $text-muted;
}
.actions Button:hover {
    background: $accent;
    color: $text;
}
.actions #action-open {
    dock: right;
}

#conversation {
    width: 88%;
    height: 88%;
    background: $surface;
    border: round $accent;
}
#conversation-title {
    height: 1;
    padding: 0 2;
    background: $panel;
}
#conversation-body {
    height: 1fr;
    padding: 0 1;
}
#conversation-keys {
    height: 1;
    padding: 0 2;
    color: $text-muted;
    background: $panel;
}
